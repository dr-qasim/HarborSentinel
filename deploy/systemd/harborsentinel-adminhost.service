[Unit]
Description=HarborSentinel AdminHost
After=network.target harborsentinel.service
Wants=network.target

[Service]
Type=simple
User=harborsentinel
Group=harborsentinel
WorkingDirectory=/opt/harborsentinel-adminhost/current
Environment=ASPNETCORE_ENVIRONMENT=Production
ExecStart=/opt/harborsentinel-adminhost/current/HarborSentinel.AdminHost
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/harborsentinel/data

[Install]
WantedBy=multi-user.target
