[Unit]
Description=HarborSentinel Bot
After=network.target

[Service]
Type=simple
User=harborsentinel
Group=harborsentinel
WorkingDirectory=/opt/harborsentinel
ExecStart=/opt/harborsentinel/HarborSentinel.Bot
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/harborsentinel/data

[Install]
WantedBy=multi-user.target
