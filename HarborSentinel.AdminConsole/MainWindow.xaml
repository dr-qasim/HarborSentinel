<Window x:Class="HarborSentinel.AdminConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:HarborSentinel.AdminConsole.ViewModels"
        xmlns:views="clr-namespace:HarborSentinel.AdminConsole.Views"
        mc:Ignorable="d"
        Title="Операторская консоль"
        Height="920"
        Width="1480"
        MinHeight="760"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Page → View routing (DataTemplate per ViewModel type) -->
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ChatsViewModel}">
            <views:ChatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:IncidentsViewModel}">
            <views:IncidentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ExportsViewModel}">
            <views:ExportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:NodeStatusViewModel}">
            <views:NodeStatusView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>

        <!-- Nav item: icon + label centred vertically in the sidebar -->
        <DataTemplate x:Key="NavItemTemplate">
            <StackPanel HorizontalAlignment="Center" Margin="0,2">
                <TextBlock Text="{Binding Icon}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}"
                           FontSize="11"
                           FontWeight="Normal"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,5,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Nav ListBoxItem: full-width, hand cursor, no focus rect -->
        <Style x:Key="NavItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding Caption}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ══ Top menu bar ══ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Выход" Click="OnExitClick" />
            </MenuItem>
        </Menu>

        <!-- ══ Bottom status bar ══ -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding IncidentStatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ReadOnlyModeText}" />
            </StatusBarItem>
        </StatusBar>

        <!-- ══ Main area: sidebar (left) + content (right) ══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Left navigation sidebar ── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- App identity header -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            BorderThickness="0,0,0,1"
                            Padding="10,14,10,12" Background="White">
                        <StackPanel>
                            <Image Source="Assets/logo.jpg"
                                   Width="44"
                                   Height="90"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   ToolTip="HarborSentinel" >
                                <Image.OpacityMask>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="Black"/>
                                        <GradientStop Color="White" Offset="1"/>
                                    </LinearGradientBrush>
                                </Image.OpacityMask>
                            </Image>
                            <TextBlock Text="Дозор"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Операторская консоль"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </StackPanel>
                    </Border>

                    <!-- Navigation items -->
                    <ListBox DockPanel.Dock="Top"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem}"
                             ItemTemplate="{StaticResource NavItemTemplate}"
                             ItemContainerStyle="{StaticResource NavItemContainerStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <!-- ── Right content area ── -->
            <Grid Grid.Column="1" Margin="14,12,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page header: title + subtitle -->
                <StackPanel Grid.Row="0" MaxWidth="1300">
                    <TextBlock Text="{Binding CurrentPage.Title}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding CurrentPage.Subtitle}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </StackPanel>

                <!-- Page content — routed via DataTemplates in Window.Resources -->
                <ContentControl Grid.Row="2"
                                Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
