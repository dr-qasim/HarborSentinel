<Window x:Class="HarborSentinel.AdminConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:HarborSentinel.AdminConsole.ViewModels"
        xmlns:views="clr-namespace:HarborSentinel.AdminConsole.Views"
        mc:Ignorable="d"
        Title="Операторская консоль"
        Height="920"
        Width="1480"
        MinHeight="760"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ChatsViewModel}">
            <views:ChatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:IncidentsViewModel}">
            <views:IncidentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ExportsViewModel}">
            <views:ExportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:NodeStatusViewModel}">
            <views:NodeStatusView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Выход" Click="OnExitClick" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding IncidentStatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ReadOnlyModeText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel MaxWidth="1180">
                    <TextBlock Text="{Binding ShellTitle}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding ShellSubtitle}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentPage.Title}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding CurrentPage.Subtitle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <TabControl Grid.Row="2"
                        ItemsSource="{Binding NavigationItems}"
                        SelectedItem="{Binding SelectedNavigationItem}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" Margin="8,2" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding Page}" Margin="8" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
