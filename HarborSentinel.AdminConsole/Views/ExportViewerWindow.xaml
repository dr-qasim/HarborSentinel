<Window x:Class="HarborSentinel.AdminConsole.Views.ExportViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HarborSentinel.AdminConsole.Views"
        mc:Ignorable="d"
        Width="1080"
        Height="820"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding ContentSummary}"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Закрыть"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Сводка">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ID задачи" Style="{StaticResource FieldLabelStyle}" />
                    <views:CopyValueBlock Grid.Row="0" Grid.Column="1"
                                          DisplayText="{Binding JobId}"
                                          CopyValue="{Binding JobId}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Имя файла" Style="{StaticResource FieldLabelStyle}" />
                    <views:CopyValueBlock Grid.Row="0" Grid.Column="3"
                                          DisplayText="{Binding FileName}"
                                          CopyValue="{Binding FileName}"
                                          TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Область" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ScopeSummary}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Тип файла" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ContentType}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Открыто" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DownloadedAt}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Результат" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ResultSummary}" TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <TabControl Grid.Row="1" Margin="0,12,0,0">
                <TabItem Header="Представление">
                    <ScrollViewer Padding="12"
                                  VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding StructuredContent}" />
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Raw JSON">
                    <Grid Margin="12">
                        <TextBox Text="{Binding RawJson}"
                                 Style="{StaticResource ReadonlyContentBoxStyle}"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Padding="12,0,12,12">
            <TextBlock Text="Содержимое читается локально в консоли и не требует открытия файла во внешнем редакторе."
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
