<UserControl x:Class="HarborSentinel.AdminConsole.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:HarborSentinel.AdminConsole.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,8">
            <GroupBox Header="SSH-туннель">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Профиль" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding TunnelProfiles}"
                                  SelectedItem="{Binding SelectedTunnelProfile}"
                                  DisplayMemberPath="ProfileName" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Имя профиля" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding SelectedTunnelProfile.ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                        <TextBlock Text="SSH host" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding SelectedTunnelProfile.Host, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
                        <TextBlock Text="SSH port" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding SelectedTunnelProfile.Port, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding SelectedTunnelProfile.Username, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Режим аутентификации" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding AuthModes}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedTunnelProfile.AuthMode}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,12">
                        <TextBlock Text="Локальный порт" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding SelectedTunnelProfile.LocalPort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,12">
                        <TextBlock Text="Auto-connect" Style="{StaticResource FieldLabelStyle}" />
                        <CheckBox IsChecked="{Binding SelectedTunnelProfile.AutoConnectOnStartup}"
                                  Content="Подключать при старте" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Удалённый host" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding SelectedTunnelProfile.RemoteHost, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="Удалённый port" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding SelectedTunnelProfile.RemotePort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="2"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,12"
                                Visibility="{Binding IsPasswordAuthSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="SSH пароль" Style="{StaticResource FieldLabelStyle}" />
                        <PasswordBox infra:PasswordBoxAssistant.BindPassword="True"
                                     infra:PasswordBoxAssistant.BoundPassword="{Binding PasswordInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding PasswordStorageStatus}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="3"
                          Grid.ColumnSpan="4"
                          Visibility="{Binding IsPrivateKeyAuthSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.8*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="Путь к приватному ключу" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SelectedTunnelProfile.PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,20,12,12" VerticalAlignment="Bottom">
                            <Button Command="{Binding BrowsePrivateKeyCommand}" Content="Обзор..." />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Passphrase ключа" Style="{StaticResource FieldLabelStyle}" />
                            <PasswordBox infra:PasswordBoxAssistant.BindPassword="True"
                                         infra:PasswordBoxAssistant.BoundPassword="{Binding PrivateKeyPassphraseInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding PrivateKeyPassphraseStorageStatus}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="0,0,0,8">
                        <Button Margin="0,0,8,8" Command="{Binding CreateTunnelProfileCommand}" Content="Новый профиль" />
                        <Button Margin="0,0,8,8" Command="{Binding SaveTunnelProfileCommand}" Content="Сохранить профиль" />
                        <Button Margin="0,0,8,8" Command="{Binding DeleteTunnelProfileCommand}" Content="Удалить профиль" />
                        <Button Margin="0,0,8,8" Command="{Binding TestTunnelCommand}" Content="Проверить" />
                        <Button Margin="0,0,8,8" Command="{Binding ConnectTunnelCommand}" Content="Подключить" />
                        <Button Margin="0,0,8,8" Command="{Binding DisconnectTunnelCommand}" Content="Отключить" />
                        <Button Margin="0,0,8,8" Command="{Binding ReconnectTunnelCommand}" Content="Переподключить" />
                    </WrapPanel>

                    <TextBlock Grid.Row="5"
                               Grid.ColumnSpan="4"
                               Text="{Binding TunnelStatus}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="6"
                               Grid.ColumnSpan="4"
                               Margin="0,6,0,0"
                               Text="{Binding TunnelStatusHint}"
                               TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Подключение к AdminHost">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Адрес AdminHost" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding HostUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Токен API" Style="{StaticResource FieldLabelStyle}" />
                        <PasswordBox infra:PasswordBoxAssistant.BindPassword="True"
                                     infra:PasswordBoxAssistant.BoundPassword="{Binding ApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Тайм-аут, сек" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Width="120"
                                 HorizontalAlignment="Left"
                                 Text="{Binding RequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                               Margin="12,0,0,0" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Command="{Binding SaveConnectionSettingsCommand}" Content="Сохранить настройки" />
                        <Button Command="{Binding RefreshCommand}" Content="Обновить" />
                    </WrapPanel>

                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="4"
                               Margin="0,12,0,0"
                               Text="{Binding ConnectionStatus}"
                               TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Сводка">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Узел" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HostSummary}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Пути runtime" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeSummary}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Безопасность" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SecuritySummary}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Последнее обновление" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastUpdated}" TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Показатели runtime">
                <Grid Margin="8">
                    <DataGrid ItemsSource="{Binding Metrics}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Показатель" Binding="{Binding Label}" Width="220" />
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="140" />
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Hint}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Header="{Binding WarningsHeadline}">
                <Grid Margin="8">
                    <ListBox ItemsSource="{Binding Warnings}" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
