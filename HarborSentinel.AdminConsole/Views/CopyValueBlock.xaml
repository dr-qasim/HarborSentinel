<UserControl x:Class="HarborSentinel.AdminConsole.Views.CopyValueBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d">
    <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right"
                Style="{StaticResource CopyInlineButtonStyle}"
                Click="OnCopyClick"
                IsEnabled="{Binding HasCopyValue, ElementName=Root}" />
        <TextBlock Margin="0,0,4,0"
                   Text="{Binding DisplayText, ElementName=Root}"
                   TextWrapping="{Binding TextWrapping, ElementName=Root}"
                   VerticalAlignment="Center" />
    </DockPanel>
</UserControl>
