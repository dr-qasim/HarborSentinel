<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="HarborSentinel.Viewer.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="using:HarborSentinel.Viewer.Converters"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Открыть файлы" Click="OpenFilesClick" />
                <Button Margin="8,0,0,0" Content="Открыть папку" Click="OpenFolderClick" />
                <Button Margin="8,0,0,0" Content="Очистить" Click="ClearClick" />
                <Button Margin="8,0,0,0" Content="Экспорт JSONL" Click="ExportJsonlClick" />
                <Button Margin="8,0,0,0" Content="Экспорт CSV" Click="ExportCsvClick" />
            </StackPanel>

            <TextBlock x:Name="StatusTextBlock" Margin="0,8,0,0" />
            <TextBlock x:Name="SummaryTextBlock" Margin="0,4,0,0" FontWeight="SemiBold" />

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Фильтры" />
            <ToggleSwitch x:Name="FlaggedOnlySwitch" Margin="0,8,0,0" Toggled="FlaggedOnlyToggled" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Margin="0,0,6,0" Content="Все" Click="PresetAllClick" />
                <Button Margin="0,0,6,0" Content="Flagged" Click="PresetFlaggedClick" />
                <Button Margin="0,0,6,0" Content="Сегодня" Click="PresetTodayClick" />
                <Button Content="Последний час" Click="PresetLastHourClick" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock VerticalAlignment="Center" Text="Контекст ± сообщений" />
                <TextBox x:Name="ContextRadiusTextBox"
                         Width="72"
                         Margin="8,0,0,0"
                         TextChanged="ContextRadiusTextChanged" />
            </StackPanel>

            <TextBlock Margin="0,8,0,0" Text="Поиск по тексту" />
            <TextBox x:Name="SearchTextBox" Margin="0,8,0,0" TextChanged="SearchTextChanged" />

            <TextBlock Margin="0,8,0,0" Text="Фильтр по user id" />
            <TextBox x:Name="UserIdTextBox" Margin="0,8,0,0" TextChanged="UserIdTextChanged" />

            <TextBlock Margin="0,8,0,0" Text="Чат" />
            <ComboBox x:Name="ChatFilterComboBox" Margin="0,8,0,0" SelectionChanged="ChatFilterSelectionChanged" />

            <TextBlock Margin="0,8,0,0" Text="Метка ИИ" />
            <ComboBox x:Name="LabelFilterComboBox" Margin="0,8,0,0" SelectionChanged="LabelFilterSelectionChanged" />

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Источники" />
            <ListView x:Name="FilesListView" Margin="0,8,0,0" DisplayMemberPath="CountText" SelectionMode="None" />

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Инциденты (помеченные)" />
            <ListView x:Name="IncidentsListView" Margin="0,8,0,0" SelectionChanged="IncidentsSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.8" Text="{Binding Meta}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Margin="0,8,0,0" Content="Фокус по инциденту" Click="FocusIncidentFilterClick" />

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Записи" />
            <ListView x:Name="RecordsListView" Margin="0,8,0,0" SelectionChanged="RecordsSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="8" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayTime}" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding DisplayChatWithId}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,2,0,0" Text="{Binding DisplayUserWithId}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.75" Text="{Binding DisplaySourceInfo}" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding TextPreview}" TextWrapping="Wrap" />
                                <Border Margin="0,6,0,0"
                                        Padding="6"
                                        BorderThickness="1"
                                        Background="#33FFB300"
                                        Visibility="{Binding Flagged, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding DisplayVerdictQuote}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Детали записи" />
            <TextBlock x:Name="DetailHeaderTextBlock" Margin="0,8,0,0" />
            <TextBlock x:Name="DetailMetaTextBlock" Margin="0,4,0,0" />
            <TextBlock x:Name="DetailAiTextBlock" Margin="0,4,0,0" />
            <TextBox x:Name="DetailTextBox"
                     Margin="0,8,0,0"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MinHeight="96"
                     MaxHeight="220" />

            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Raw JSON" />
            <TextBox x:Name="RawJsonTextBox"
                     Margin="0,4,0,0"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     MinHeight="180"
                     MaxHeight="380" />

            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Контекст сообщений" />
            <TextBox x:Name="ContextTextBox"
                     Margin="0,4,0,0"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MinHeight="160"
                     MaxHeight="320" />

            <TextBlock x:Name="DetailSourceFileTextBlock" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
