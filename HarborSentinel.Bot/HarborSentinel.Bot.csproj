<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>dotnet-HarborSentinel.Bot-e294a6da-224e-4cde-9229-6b466a25516e</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Telegram.Bot" Version="22.7.0" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="data\flagged_lists\" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="data\hadith_daily_settings.json" />
		<Content Remove="data\harborsentinel.db" />
		<Content Remove="data\messages-emergency-backup.jsonl" />
		<Content Remove="data\messages-*.jsonl" />
		<Content Remove="data\flagged_lists\**\*" />
		<Content Remove="data\tracked_exports\**\*" />
		<Content Remove="data\admin_exports\**\*" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json" CopyToPublishDirectory="Never" />
		<None Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
		<None Update="appsettings.json.example" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="appsettings.json" CopyToPublishDirectory="Never" />
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
		<Content Update="appsettings.json.example" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="data\hadiths-ru.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<Content Update="data\duas-ru.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<Content Update="data\welcome-duas-ru.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<Content Update="data\azkar-ru.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<Content Update="data\ayat-ru.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>
</Project>
